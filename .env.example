# Copy this file to .env and fill in the real values. .env is git-ignored
# and is the only place these should ever live -- config.py has no
# hardcoded personal defaults (repo may be public), so all of these are
# required.

LEETCODE_USERNAME=
SENDER_EMAIL=
RECIPIENT_EMAIL=

# Gmail App Password for the sender account (NOT the normal Gmail password
# -- generate one at https://myaccount.google.com/apppasswords, which
# requires 2-Step Verification to be enabled on the account first).
SMTP_APP_PASSWORD=

# Optional overrides:
# PROBLEM_COUNT=7
# EASY_RATIO=0.4
